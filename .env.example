# Local development credentials. `scripts/init-platform` generates a private
# .env with random values; do not commit the generated file.
DATA_ROOT=/home/kent/Data
POLARIS_REALM=POLARIS
POLARIS_ROOT_CLIENT_ID=root
POLARIS_ROOT_CLIENT_SECRET=replace-me
POLARIS_CATALOG=research
POSTGRES_USER=polaris
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=polaris
RUSTFS_ACCESS_KEY=replace-me
RUSTFS_SECRET_KEY=replace-me
# Bind-mounted warehouse ownership (normally your local Linux UID/GID).
LOCAL_UID=1000
LOCAL_GID=1000
ICEBERG_BUCKET=research-lakehouse
