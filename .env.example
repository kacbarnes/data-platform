# Local development credentials. `lake platform init` generates a private
# .env with random values; do not commit the generated file.
# Use an absolute native-host path; init expands relative paths and ~ for you.
DATA_ROOT=/path/to/storage
# Optional private contract directory; defaults to DATA_ROOT/contracts.
# CONTRACTS_DIR=/path/to/private/contracts
PLATFORM_BACKEND=docker
COMPOSE_PROJECT_NAME=research-data-platform
POLARIS_PORT=8181
POLARIS_HEALTH_PORT=8182
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
POLARIS_URL=http://localhost:8181
RUSTFS_CLIENT_ENDPOINT=localhost:9000
POLARIS_REALM=POLARIS
POLARIS_ROOT_CLIENT_ID=root
POLARIS_ROOT_CLIENT_SECRET=replace-me
POLARIS_CATALOG=research
POSTGRES_USER=polaris
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=polaris
RUSTFS_ACCESS_KEY=replace-me
RUSTFS_SECRET_KEY=replace-me
# Bind-mounted warehouse ownership (normally your local Linux UID/GID).
LOCAL_UID=1000
LOCAL_GID=1000
ICEBERG_BUCKET=research-lakehouse
