#!/usr/bin/env bash
set -euo pipefail

PYTHON_BIN="${DATA_PLATFORM_PYTHON:-python}"
if ! command -v "${PYTHON_BIN}" >/dev/null 2>&1; then
  echo "init-platform: activate your Python environment or set DATA_PLATFORM_PYTHON" >&2
  exit 1
fi

# Initialization creates configuration only; startup is an explicit second step.
exec "${PYTHON_BIN}" -m lake_cli platform init "$@"
