#!/usr/bin/env bash
set -euo pipefail

PYTHON_BIN="${DATA_PLATFORM_PYTHON:-python}"

if ! command -v "${PYTHON_BIN}" >/dev/null 2>&1; then
  echo "lake: Python interpreter not found: ${PYTHON_BIN}" >&2
  echo "Activate the environment containing lake-cli," >&2
  echo "or set DATA_PLATFORM_PYTHON to its Python executable." >&2
  exit 1
fi

exec "${PYTHON_BIN}" -m lake_cli "$@"
