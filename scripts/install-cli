#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PYTHON_BIN="${DATA_PLATFORM_PYTHON:-python}"

if ! command -v "${PYTHON_BIN}" >/dev/null 2>&1; then
  echo "install-cli: Python interpreter not found: ${PYTHON_BIN}" >&2
  echo "Activate your environment or set DATA_PLATFORM_PYTHON." >&2
  exit 1
fi

"${PYTHON_BIN}" -m pip install \
  --no-deps \
  --no-build-isolation \
  --editable "${PROJECT_ROOT}"

echo "Installed lake CLI into the selected Python environment."
